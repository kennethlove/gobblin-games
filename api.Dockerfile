ARG RUST_VERSION=1.99.1

FROM rust:${RUST_VERSION}-slim-bookworm AS builder
WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libssl-dev \
        pkg-config \
        curl \
        ca-certificates \
        git \
        llvm \
        libclang-dev \
        build-essential && \
    rm -rf /var/lib/apt/lists/*

# Workspace layout must match the root Cargo.toml member list, or the
# workspace resolve fails before the first compile.
COPY Cargo.toml Cargo.lock ./
COPY announcers/ announcers/
COPY api/ api/
COPY areas/ areas/
COPY characters/ characters/
COPY game/ game/
COPY world/ world/
COPY migrations/ migrations/
COPY schemas/ schemas/
COPY shared/ shared/

RUN --mount=type=cache,target=/app/target/ \
    --mount=type=cache,target=/usr/local/cargo/registry/ \
    cargo build --release --manifest-path api/Cargo.toml && \
    cp /app/target/release/api /app/api-bin

FROM debian:bookworm-slim AS final

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libclang1 \
        curl && \
    rm -rf /var/lib/apt/lists/*

RUN adduser \
    --disabled-password \
    --gecos "" \
    --home "/nonexistent" \
    --shell "/sbin/nologin" \
    --no-create-home \
    --uid "10001" \
    api_user

# Cargo's workspace target dir lives inside a cache mount, so the binary is
# copied out to regular filesystem during the builder RUN above.
COPY --from=builder /app/api-bin /usr/local/bin/gg_api

RUN chown -R api_user /usr/local/bin/gg_api && \
    chmod +x /usr/local/bin/gg_api

USER api_user

# The binary bakes env!("CARGO_MANIFEST_DIR") at compile time (/app/api), so
# the runtime layout must mirror it: schemas and migrations resolve to
# /app/schemas and /app/migrations, templates to /app/api/templates. The
# assets routes read the CARGO_MANIFEST_DIR *env var* at request time.
WORKDIR /app/api
ENV CARGO_MANIFEST_DIR=/app/api
ENV STORAGE_PATH=/app/api/uploads

RUN mkdir -p /app/api/uploads

COPY --from=builder /app/schemas /app/schemas
COPY --from=builder /app/migrations /app/migrations
COPY --from=builder /app/api/templates /app/api/templates
# assets/dist holds the committed built CSS/JS; assets/icons holds the
# sprites generated by api/build.rs during the builder stage.
COPY --from=builder /app/api/assets/dist /app/api/assets/dist
COPY --from=builder /app/api/assets/icons /app/api/assets/icons

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl --fail http://localhost:3000/health || exit 1

EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/gg_api"]

ENV=development

# API server. Default 3000.
API_PORT=3000

# "true" = production behavior: info-level tracing, secure cookies, dev
# endpoints (/dev/verify-email) disabled, otel deployment.environment
# = "production". Anything else = debug tracing + dev endpoints.
PRODUCTION=true

# Public origin used in generated email links (default http://localhost:3000)
APP_URL=http://localhost:3000

# SurrealDB connection
SURREAL_HOST=ws://localhost:8000
SURREAL_USER=root
SURREAL_PASS=root

# Signs auth JWTs (login/refresh cookies) and, unless EMAIL_SECRET is set,
# email verification tokens. REQUIRED in production.
SURREAL_JWT_SECRET=

# SurrealDB namespace and database (optional; defaults shown)
APP_SURREAL_NAMESPACE=gobblin-games
APP_SURREAL_DATABASE=games

# CORS Configuration
# Comma-separated list of allowed origins for CORS (e.g., http://localhost:8080,https://127.0.0.1:8080)
# IMPORTANT: Wildcards (*) are NOT allowed in production mode
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Rate Limiting Configuration
# Requests per second allowed per user/IP combination
RATE_LIMIT_PER_SECOND=2
# Maximum burst size (number of requests that can be made in quick succession)
RATE_LIMIT_BURST=50

# Per-user goblin cap (default 128)
MAX_GOBLINS_PER_USER=128

# Cloudflare image transformations for served uploads (empty = off, dev).
# Behind the Cloudflare proxy in prod use e.g.:
IMAGE_CDN_PREFIX=

# User uploads → object storage (cxi). Unset = local files under STORAGE_PATH.
# STORAGE_BACKEND=s3
# STORAGE_PATH=uploads
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=gobblin-uploads
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Email. EMAIL_BACKEND: mailpit (local SMTP, default in debug builds) or
# resend (default in release builds). Unknown values fall back to mailpit.
# EMAIL_BACKEND=mailpit
# From address for outgoing mail (default noreply@gobblin.games)
# EMAIL_FROM=
# Secret for verification tokens (defaults to SURREAL_JWT_SECRET, then an
# INSECURE hardcoded fallback — set explicitly in production)
# EMAIL_SECRET=
# MAILPIT_HOST=localhost
# MAILPIT_PORT=1025
# RESEND_API_KEY=

# OpenTelemetry traces (self-hosted SigNoz / any OTLP collector).
# Unset = no tracing, exactly the pre-OTel behavior.
# HTTP protobuf on purpose (crate default); SDK appends /v1/traces for you,
# so give the collector BASE url — do not include the path.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Service name shown in SigNoz (default gobblin-api)
# OTEL_SERVICE_NAME=gobblin-api
# Optional extra resource attributes, e.g. deployment.environment=production
# OTEL_RESOURCE_ATTRIBUTES=
